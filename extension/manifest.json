{
  "manifest_version": 3,
  "name": "Dittod Action Recorder",
  "version": "1.0.0",
  "description": "Records user actions for Dittod skill creation",
  "permissions": [],
  "web_accessible_resources": [{
    "resources": ["monitoring-script.js"],
    "matches": ["<all_urls>"]
  }],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content-script-injector.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
